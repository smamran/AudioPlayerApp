{
  "languages": {
    "C++": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on"
    },
    "CMake": {
      "tab_size": 4,
      "format_on_save": "on"
    }
  },
  "lsp": {
    "clangd": {
      "initialization_options": {
        "fallbackFlags": [
          "-std=c++17"
        ],
        "compilationDatabasePath": "build"
      }
    }
  }
}
